{
  "title": "Discord User",
  "type": "object",
  "required": [
    "id",
    "username"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "username": {
      "type": "string"
    },
    "global_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "bot": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
